# --- Default backend: Claude Code CLI (no API key required) ----------------
# Authentication is whatever you already have set up for `claude` itself.
# Make sure you have run `claude` interactively at least once and that
# `claude --version` works on your PATH.

# Credentials used by the Login Agent when a password field is detected.
QA_USERNAME=test@example.com
QA_PASSWORD=Password123!

# --- Optional: switch to direct Anthropic API ------------------------------
# Uncomment to bypass the CLI and call the API directly. Requires:
#   pip install langchain-anthropic
# QA_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
# QA_MODEL=claude-sonnet-4-6

# --- Debugging -------------------------------------------------------------
# QA_DEBUG_PROMPT=1   # log the first 2000 chars of every prompt at DEBUG level
